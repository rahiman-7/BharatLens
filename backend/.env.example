# BharatLens Backend — Production Environment Configuration Template
ENVIRONMENT=production
DATABASE_URL=sqlite:////var/data/bharatlens.db
JWT_SECRET_KEY=
NEWS_API_KEY=
GNEWS_API_KEY=
CORS_ORIGINS=https://bharatlens.vercel.app,http://localhost:5173
ENABLE_NEWS_SCHEDULER=true
NEWS_INGEST_INTERVAL_MINUTES=60
NEWS_INGEST_ON_STARTUP=false
REGIONAL_NEWS_MAX_REQUESTS_PER_CYCLE=1
SHOW_DEMO_ARTICLES=false

